  "theme": "opencode",
  "autoupdate": true,
  "mcp": {
    "adk-docs-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcpdoc",
        "mcpdoc",
        "--urls",
        "AgentDevelopmentKit:https://adk.dev/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": true
    },
    "supabase-local": {
      "type": "remote",
      "url": "http://127.0.0.1:54321/mcp",
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "enabled": false
    },
    "podman": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "podman-mcp-server@latest"
      ],
      "enabled": false
    }
  },
  "plugin": [],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "lsp": true
